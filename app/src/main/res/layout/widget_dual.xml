<?xml version="1.0" encoding="utf-8"?>
<!--
  双栏卡片：左右两个独立 ListView，中间一条 1dp 竖线分隔。
  RemoteViews 只支持固定控件，所以两栏各写一套 id，不能复用同一个 ListView。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <!-- 左栏 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/left_title_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/left_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/left_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="+"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/left_area"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ListView
                android:id="@+id/rows_left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="2dp"
                android:scrollbars="none" />

            <!-- 铺满整栏：空态时点栏内任意处都能进编辑页 -->
            <TextView
                android:id="@+id/empty_left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:text="点这里添加"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 中缝：RemoteViews 不允许裸 <View>（Class not allowed to be inflated android.view.View），用 TextView 代替 -->
    <TextView
        android:id="@+id/divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#33FFFFFF" />

    <!-- 右栏 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/right_title_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/right_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/right_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="+"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/right_area"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ListView
                android:id="@+id/rows_right"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="2dp"
                android:scrollbars="none" />

            <!-- 铺满整栏：空态时点栏内任意处都能进编辑页 -->
            <TextView
                android:id="@+id/empty_right"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:text="点这里添加"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
